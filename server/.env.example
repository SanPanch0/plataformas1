# Puerto del servidor (Render lo define automáticamente)
PORT=3001
NODE_ENV=development

# URL del frontend permitida por CORS (producción). Varias separadas por coma.
# Ejemplo: CLIENTE_URL=https://tareas-app.vercel.app
CLIENTE_URL=

# Cadena de conexión de MongoDB Atlas (NO la subas a Git)
# Ejemplo: mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/tareas?retryWrites=true&w=majority
MONGODB_URI=
